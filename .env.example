# AI 服务（OpenAI 兼容协议）。不填也能跑：AI 模块会进入「演示模式」。
# 推荐用自有前缀，避免被宿主机上已有的 OPENAI_* 变量误伤。
BLOCKSET_AI_KEY=
BLOCKSET_AI_BASE=https://api.deepseek.com/v1
BLOCKSET_AI_MODEL=deepseek-chat
BLOCKSET_AI_IMAGE_MODEL=gpt-image-1
# 画图专用接口地址（可选）：对话服务通常没有 /images/generations
BLOCKSET_AI_IMAGE_BASE=

# AI 简报「重点新闻」：用 DeepSeek 网页搜索 + 抓取补详情（需 Key 支持 Search/Fetch，按次计费）
# 设为 0 可关闭；BRIEF_NEWS_MAX 控制每次最多几条（1-5，默认 3）
BRIEF_NEWS=1
BRIEF_NEWS_MAX=3

# 兼容写法（BLOCKSET_AI_* 未设置时生效）
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat
# OPENAI_IMAGE_MODEL=gpt-image-1

# 热榜数据源（可选）。本地 DailyHotApi 服务：npm run hot:start → http://127.0.0.1:6688
# 留空则使用内置示例数据。
HOT_API_BASE=

# 登录 cookie 签名密钥。生产环境必须替换为随机值。
SESSION_SECRET=

# 站点信息（可选）
SITE_NAME=块集 BlockSet
